# ============================================================
# BACKEND CONFIGURATION
# ============================================================
PROJECT_NAME="UniHack 2026 Product Intelligence Platform API"
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production"

# Database Configuration
DATABASE_URL="sqlite:///./product_intelligence.db"

# Storage Configurations
STORAGE_BASE_PATH="./data_storage"
PERMANENT_KNOWLEDGE_PATH="./data_storage/permanent_knowledge"
TEMP_CACHE_PATH="./data_storage/temp_cache"
USER_UPLOADS_PATH="./data_storage/user_uploads"

# Storage Safety Constraints
MAX_PERMANENT_SIZE_BYTES=2147483648
MAX_TEMP_CACHE_SIZE_BYTES=2147483648
MAX_CACHE_SIZE_BYTES=4294967296
CACHE_RETENTION_DAYS=7

# Vector Database Configuration
VECTOR_STORE_PATH="./data_storage/vector_store"
DEFAULT_TOP_K=5

# ============================================================
# AI / ENGINE CONFIGURATION
# ============================================================

# Pipeline Modes
AI_ENGINE_MODE=ollama
AI_ENGINE_AGENT1_MODE=freellmapi
AI_ENGINE_AGENT2_MODE=freellmapi

# Ollama / Qwen Configuration (Local Planner/Agent 1 Default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_TIMEOUT=180
OLLAMA_LLM_LIBRARY=cuda_v12

# FreeLLMAPI Gateway
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL_AGENT1=gpt-oss-120b
FREELLMAPI_MODEL_AGENT2=gpt-oss-120b

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
VITE_API_URL="http://localhost:8000"
